<Window x:Class="ExcelGitDiffViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ExcelGitDiffViewer.Converters"
        xmlns:local="clr-namespace:ExcelGitDiffViewer"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:ExcelGitDiffViewer.ViewModels"
        Title="Excel Git Diff Viewer" Height="720" Width="1180"
        Icon="/Assets/app.ico"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:DiffKindToBrushConverter x:Key="DiffBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            VBA コード行の固定行高(px)。変更前・変更後を別 ScrollViewer に分けたため、行 N の高さが
            左右で 1px でもずれると縦スクロール同期が累積的に破綻する。Consolas には CJK 字形が無く、
            日本語コメント行はフォントフォールバックで行送りが約 1.41em まで伸びる一方、ASCII のみの
            行は Consolas の約 1.17em で収まるため、放置すると片側だけ背が高くなる。
              12px × 1.41 ≒ 16.9px → 余裕を見て 18px で固定する。
            MinHeight ではフォールバック行がそれを超えて伸びてしまうため必ず Height で固定すること。
            FontSize は既定値の継承だと OS のテキスト拡大設定で動くので明示指定し、
            Vba.CodeFontSize を変えるときは Vba.LineHeight も必ず一緒に見直す。
        -->
        <sys:Double x:Key="Vba.CodeFontSize">12</sys:Double>
        <sys:Double x:Key="Vba.LineHeight">18</sys:Double>

        <!-- 変更前ペインの1行。VbaLineRow の Left* だけを描画する（同じ行オブジェクトを右ペインと共有）。 -->
        <DataTemplate x:Key="VbaLeftLineTemplate">
            <Grid Height="{StaticResource Vba.LineHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="VbaLeftCode" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LeftNumberDisplay}"
                           Foreground="{DynamicResource Grid.RowNumberFg}" TextAlignment="Right"
                           FontFamily="Consolas" FontSize="{StaticResource Vba.CodeFontSize}"
                           VerticalAlignment="Center" Padding="0,0,6,0" />
                <Border Grid.Column="1" Background="{Binding LeftKind, Converter={StaticResource DiffBrush}}">
                    <TextBlock Text="{Binding LeftText}" FontFamily="Consolas"
                               FontSize="{StaticResource Vba.CodeFontSize}"
                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 変更後ペインの1行。構造は左テンプレートと同一で、Right* にバインドする。 -->
        <DataTemplate x:Key="VbaRightLineTemplate">
            <Grid Height="{StaticResource Vba.LineHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="VbaRightCode" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding RightNumberDisplay}"
                           Foreground="{DynamicResource Grid.RowNumberFg}" TextAlignment="Right"
                           FontFamily="Consolas" FontSize="{StaticResource Vba.CodeFontSize}"
                           VerticalAlignment="Center" Padding="0,0,6,0" />
                <Border Grid.Column="1" Background="{Binding RightKind, Converter={StaticResource DiffBrush}}">
                    <TextBlock Text="{Binding RightText}" FontFamily="Consolas"
                               FontSize="{StaticResource Vba.CodeFontSize}"
                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- キーボードショートカット (A-1)。DataGrid のセル操作より Window レベルの入力が優先される。 -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpenCommand" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindCommand" />
        <CommandBinding Command="{x:Static local:MainWindow.NextDiffCommand}" Executed="OnNextDiffCommand" />
        <CommandBinding Command="{x:Static local:MainWindow.PrevDiffCommand}" Executed="OnPrevDiffCommand" />
        <CommandBinding Command="{x:Static local:MainWindow.HomeViewCommand}" Executed="OnHomeViewCommand" />
        <CommandBinding Command="{x:Static local:MainWindow.DataViewCommand}" Executed="OnDataViewCommand" />
        <CommandBinding Command="{x:Static local:MainWindow.VbaViewCommand}" Executed="OnVbaViewCommand" />
        <CommandBinding Command="{x:Static local:MainWindow.ToggleReviewCommand}" Executed="OnToggleReviewCommand" />
        <CommandBinding Command="{x:Static local:MainWindow.PrevSheetCommand}" Executed="OnPrevSheetCommand" />
        <CommandBinding Command="{x:Static local:MainWindow.NextSheetCommand}" Executed="OnNextSheetCommand" />
        <CommandBinding Command="{x:Static local:MainWindow.ShowHelpCommand}" Executed="OnShowHelpCommand" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F3" Command="{x:Static local:MainWindow.NextDiffCommand}" />
        <KeyBinding Key="F3" Modifiers="Shift" Command="{x:Static local:MainWindow.PrevDiffCommand}" />
        <KeyBinding Key="H" Modifiers="Control" Command="{x:Static local:MainWindow.HomeViewCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static local:MainWindow.HomeViewCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static local:MainWindow.DataViewCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static local:MainWindow.VbaViewCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{x:Static local:MainWindow.ToggleReviewCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{x:Static local:MainWindow.PrevSheetCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{x:Static local:MainWindow.NextSheetCommand}" />
        <KeyBinding Key="F1" Command="{x:Static local:MainWindow.ShowHelpCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ① ツールバー -->
        <Border Grid.Row="0" Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Vertical">
                <DockPanel Margin="10,6">
                <!-- 操作ガイド (F1) -->
                <Button DockPanel.Dock="Left" Content="?" Padding="10,3" Margin="0,0,6,0"
                        Click="OnShowHelpClick" ToolTip="操作ガイド (F1)" />
                <!-- テーマ切替トグル (B-4)。押下で Dark ⇔ Light を切り替え、設定を永続化する -->
                <Button DockPanel.Dock="Left" Content="{Binding ThemeToggleIcon}" Padding="8,3" Margin="0,0,16,0"
                        Click="OnToggleThemeClick" ToolTip="テーマを切り替え (ライト / ダーク)" />
                <!-- 表示モード切替（仕様 §4）。ドロップダウンで UI を圧縮。CurrentView に双方向バインドし、
                     Ctrl+1/2/3 のキーボード切替とも同期する。 -->
                <ComboBox VerticalAlignment="Center" MinWidth="180"
                          SelectedValue="{Binding CurrentView, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          ToolTip="表示モードを切り替え (Ctrl+1 / Ctrl+2 / Ctrl+3)"
                          Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                    <ComboBoxItem Content="🏠 ホーム" Tag="{x:Static vm:ViewMode.Home}" />
                    <ComboBoxItem Content="データ・数式ビュー" Tag="{x:Static vm:ViewMode.DataFormula}" />
                    <ComboBoxItem Content="VBAコードビュー" Tag="{x:Static vm:ViewMode.Vba}"
                                  IsEnabled="{Binding HasVba}" />
                </ComboBox>
                <!-- レビューモード操作（データ・数式ビュー／VBA コードビュー表示中） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                            Visibility="{Binding ShowReviewToolbar, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="レビューモード（差分のみ）" VerticalAlignment="Center"
                              IsChecked="{Binding IsReviewMode, Mode=TwoWay}" />
                    <TextBlock Text="{Binding SelectedSheet.DiffRowCount, StringFormat=差分 {0} 件}"
                               Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Visibility="{Binding IsDataView, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding SelectedVbaModule.DiffLineCount, StringFormat=差分 {0} 行}"
                               Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Visibility="{Binding IsVbaView, Converter={StaticResource BoolToVis}}" />
                    <Button Content="▲ 前" Padding="8,3" Margin="12,0,0,0"
                            Click="OnPrevDiffClick" ToolTip="前の差分へ (Shift+F3)" />
                    <Button Content="▼ 次" Padding="8,3" Margin="6,0,0,0"
                            Click="OnNextDiffClick" ToolTip="次の差分へ (F3)" />
                    <!-- 差分種別フィルタ (A-5): 常に有効。既定は全 ON、いずれか OFF にするとレビューモードを自動 ON にする -->
                    <CheckBox Content="追加" VerticalAlignment="Center" Margin="16,0,0,0"
                              IsChecked="{Binding ShowAdded, Mode=TwoWay}"
                              ToolTip="挿入された行を表示（OFF にするとレビューモードが ON になり、追加行が隠れます）" />
                    <CheckBox Content="変更" VerticalAlignment="Center" Margin="8,0,0,0"
                              IsChecked="{Binding ShowModified, Mode=TwoWay}"
                              ToolTip="値・数式が変更された行を表示（OFF にするとレビューモードが ON になり、変更行が隠れます）" />
                    <CheckBox Content="削除" VerticalAlignment="Center" Margin="8,0,0,0"
                              IsChecked="{Binding ShowRemoved, Mode=TwoWay}"
                              ToolTip="削除された行を表示（OFF にするとレビューモードが ON になり、削除行が隠れます）" />
                </StackPanel>
                </DockPanel>

                <!-- 検索バー (A-2)。Ctrl+F でトグル、Esc で閉じる。折りたたみ表示。 -->
                <Border Background="{DynamicResource Bg.SurfaceAlt}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0"
                        Padding="10,6"
                        Visibility="{Binding IsSearchBarVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="検索:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg.Secondary}" Margin="0,0,8,0" />
                        <TextBox x:Name="SearchTextBox" Width="260" VerticalAlignment="Center"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnSearchTextBoxKeyDown" />
                        <Button Content="◀ 前" Padding="8,3" Margin="8,0,0,0"
                                Click="OnPrevMatchClick" ToolTip="前のヒット (Shift+Enter)" />
                        <Button Content="▶ 次" Padding="8,3" Margin="6,0,0,0"
                                Click="OnNextMatchClick" ToolTip="次のヒット (Enter)" />
                        <TextBlock Text="{Binding SearchStatus}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg.Secondary}" Margin="12,0,0,0"
                                   MinWidth="90" />
                        <CheckBox Content="全シート" VerticalAlignment="Center" Margin="8,0,0,0"
                                  IsChecked="{Binding SearchAllSheets, Mode=TwoWay}"
                                  ToolTip="全シートを横断して検索" />
                        <Button Content="×" Padding="8,1" Margin="12,0,0,0"
                                Click="OnCloseSearchClick" ToolTip="検索を閉じる (Esc)" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ② サマリー / 統計バー (B-2)。読み込み完了・エラーなし・非ローディング時に表示 -->
        <Border Grid.Row="1" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,0,0,1" Padding="12,6"
                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="サマリー:" Foreground="{DynamicResource Fg.Secondary}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />

                    <!-- 変更シート数 -->
                    <Border Background="{DynamicResource Bg.Elevated}" BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ChangedSheetCount, StringFormat=シート {0} 変更}"
                                   Foreground="{DynamicResource Fg.Primary}" />
                    </Border>

                    <!-- 追加行 -->
                    <Border Background="{DynamicResource Diff.Add.Bg}" BorderBrush="{DynamicResource Diff.Add.Fg}"
                            BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,0,8,0">
                        <TextBlock Text="{Binding TotalAddedRows, StringFormat=+{0} 行}"
                                   Foreground="{DynamicResource Diff.Add.Fg}" FontWeight="Bold" />
                    </Border>

                    <!-- 削除行 -->
                    <Border Background="{DynamicResource Diff.Del.Bg}" BorderBrush="{DynamicResource Diff.Del.Fg}"
                            BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,0,8,0">
                        <TextBlock Text="{Binding TotalRemovedRows, StringFormat=-{0} 行}"
                                   Foreground="{DynamicResource Diff.Del.Fg}" FontWeight="Bold" />
                    </Border>

                    <!-- 変更セル -->
                    <Border Background="{DynamicResource Diff.Chg.Bg}" BorderBrush="{DynamicResource Diff.Chg.Fg}"
                            BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,0,8,0">
                        <TextBlock Text="{Binding TotalChangedCells, StringFormat=~{0} セル}"
                                   Foreground="{DynamicResource Diff.Chg.Fg}" FontWeight="Bold" />
                    </Border>

                    <!-- VBA 変更モジュール (VBA なしのときは非表示) -->
                    <Border Background="{DynamicResource Accent.Muted}" BorderBrush="{DynamicResource Accent.Default}"
                            BorderThickness="1" CornerRadius="10" Padding="10,3"
                            Visibility="{Binding HasVba, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ChangedVbaModuleCount, StringFormat=VBA {0} モジュール}"
                                   Foreground="{DynamicResource Fg.Primary}" />
                    </Border>
                </StackPanel>

                <!-- 差分フィルタ（行 / 列）。レビューモード ON のときだけ表示する下位フィルタ。既定は両方 ON。 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right"
                            Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="差分のみ:" Foreground="{DynamicResource Fg.Secondary}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Content="行" VerticalAlignment="Center"
                              IsChecked="{Binding FilterRows, Mode=TwoWay}"
                              ToolTip="差分のある行だけを表示" />
                    <CheckBox Content="列" VerticalAlignment="Center" Margin="12,0,0,0"
                              IsChecked="{Binding FilterColumns, Mode=TwoWay}"
                              ToolTip="差分のある列だけを表示" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ③ 対象ファイル情報バー（読み込み後のみ表示。差分ウィンドウ直上に配置） -->
        <Border Grid.Row="2" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1" Padding="12,6"
                Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="変更前: " FontWeight="Bold" Foreground="{DynamicResource Diff.Del.Fg}" />
                    <TextBlock Text="{Binding LeftFilePath}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding LeftFilePath}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="  ⇄  " FontWeight="Bold" Foreground="{DynamicResource Fg.Secondary}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="変更後: " FontWeight="Bold" Foreground="{DynamicResource Diff.Add.Fg}" />
                    <TextBlock Text="{Binding RightFilePath}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding RightFilePath}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ④ コンテンツ領域 -->
        <Grid Grid.Row="3">
            <!-- シート一覧（左・縦並び） + 左右 DataGrid（データ・数式ビュー）。VBA コードビューと UI を統一。 -->
            <Grid Visibility="{Binding ShowDataArea, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- シート一覧（レビュー ON 時は差分ありのみ）。VBA モジュール一覧と同じ縦並び ListBox。 -->
                <ListBox Grid.Column="0" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,1,0"
                         ItemsSource="{Binding DisplaySheets}"
                         SelectedItem="{Binding SelectedSheet, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}" Padding="4,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 左右 DataGrid -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="LeftGrid" Grid.Column="0"
                              Style="{StaticResource DiffGridStyle}"
                              ItemsSource="{Binding SelectedSheet.DisplayLeftRows}"
                              ScrollViewer.ScrollChanged="OnGridScrollChanged"
                              PreviewMouseWheel="OnGridPreviewMouseWheel"
                              SelectedCellsChanged="OnSelectedCellsChanged" />

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource Border.Strong}" />

                    <DataGrid x:Name="RightGrid" Grid.Column="2"
                              Style="{StaticResource DiffGridStyle}"
                              ItemsSource="{Binding SelectedSheet.DisplayRightRows}"
                              ScrollViewer.ScrollChanged="OnGridScrollChanged"
                              PreviewMouseWheel="OnGridPreviewMouseWheel"
                              SelectedCellsChanged="OnSelectedCellsChanged" />
                </Grid>

            </Grid>

            <!-- VBA コードビュー -->
            <Grid Visibility="{Binding ShowVbaArea, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- モジュール一覧（レビュー ON 時は変更ありのみ） -->
                <ListBox Grid.Column="0" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,1,0"
                         ItemsSource="{Binding DisplayVbaModules}"
                         SelectedItem="{Binding SelectedVbaModule, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}" Padding="4,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--
                    選択モジュールの行差分。データ・数式ビュー（上の LeftGrid / RightGrid）と同じく
                    GridSplitter で左右に分割し、各ペインが独立した縦横スクロールバーを持つ。
                    以前は 1 つの ScrollViewer が左右両方を包んでおり、コード列（Auto + SharedSizeGroup）が
                    変更前の最長行まで広がって変更後を画面外へ押し出していた。
                    ペインごとに共有サイズスコープを分けることで、左の行長が右の幅に影響しなくなる。
                -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <!-- 見出しはペイン内に固定する。左右の Border は Padding・FontWeight まで同一構造に
                             保つこと（高さが違うと両ペインの1行目の Y がずれて行が揃わなくなる）。 -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Bg.Surface}" Padding="8,4">
                            <TextBlock Text="変更前" FontWeight="Bold" Foreground="{DynamicResource Diff.Del.Fg}" />
                        </Border>
                        <!-- 横バーは Auto ではなく Visible。片側だけバーが出るとビューポート高が約 12px ずれ、
                             最下部で左右の行が食い違う。縦バーは左右の Extent が同一（同じ行数 × 同じ行高）
                             なので Auto でも同時に出入りし、ずれない。 -->
                        <ScrollViewer x:Name="VbaLeftScroll"
                                      HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="OnVbaScrollChanged" PreviewMouseWheel="OnVbaPreviewMouseWheel">
                            <ItemsControl x:Name="VbaLeftItems" Grid.IsSharedSizeScope="True"
                                          ItemsSource="{Binding SelectedVbaModule.DisplayLines}"
                                          ItemTemplate="{StaticResource VbaLeftLineTemplate}" />
                        </ScrollViewer>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource Border.Strong}" />

                    <DockPanel Grid.Column="2">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Bg.Surface}" Padding="8,4">
                            <TextBlock Text="変更後" FontWeight="Bold" Foreground="{DynamicResource Diff.Add.Fg}" />
                        </Border>
                        <ScrollViewer x:Name="VbaRightScroll"
                                      HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="OnVbaScrollChanged" PreviewMouseWheel="OnVbaPreviewMouseWheel">
                            <ItemsControl x:Name="VbaRightItems" Grid.IsSharedSizeScope="True"
                                          ItemsSource="{Binding SelectedVbaModule.DisplayLines}"
                                          ItemTemplate="{StaticResource VbaRightLineTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- エラー表示 -->
            <Border Background="{DynamicResource State.Error.Bg}" BorderBrush="{DynamicResource State.Error.Border}" BorderThickness="1" CornerRadius="6"
                    Padding="20" Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="560"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="解析できませんでした" FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource State.Error.Fg}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource State.Error.Fg}" />
                </StackPanel>
            </Border>

            <!-- ホーム画面（比較方法の選択）。起動直後・「ホーム」ボタンで表示 -->
            <Grid Visibility="{Binding ShowHome, Converter={StaticResource BoolToVis}}"
                  Background="{DynamicResource Bg.Window}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760"
                                Margin="20,40,20,40">
                        <TextBlock Text="Excel Git Diff Viewer" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource Fg.Primary}" HorizontalAlignment="Center" />
                        <TextBlock Text="比較方法を選んでください" FontSize="14"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   HorizontalAlignment="Center" Margin="0,6,0,28" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Width="300" Height="180" Margin="0,0,20,0" Click="OnHomeCompareFilesClick">
                                <StackPanel>
                                    <TextBlock Text="📂" FontSize="46" HorizontalAlignment="Center" />
                                    <TextBlock Text="ファイルを比較" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,12,0,6" />
                                    <TextBlock Text="2つの Excel ファイルを選んで比較します"
                                               FontSize="12" Foreground="{DynamicResource Fg.Secondary}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="240" />
                                </StackPanel>
                            </Button>
                            <Button Width="300" Height="180" Click="OnHomeCompareGitClick">
                                <StackPanel>
                                    <TextBlock Text="🔀" FontSize="46" HorizontalAlignment="Center" />
                                    <TextBlock Text="Git 比較" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,12,0,6" />
                                    <TextBlock Text="Git 管理下の Excel をコミット間で比較します"
                                               FontSize="12" Foreground="{DynamicResource Fg.Secondary}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="240" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 最近開いた比較（履歴 0 件のときは非表示） -->
                        <StackPanel Margin="0,32,0,0"
                                    Visibility="{Binding HasRecentEntries, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="最近開いた比較" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource Fg.Primary}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding RecentEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch"
                                                Margin="0,0,0,6" Padding="12,8"
                                                Click="OnRecentEntryClick"
                                                ToolTip="{Binding DisplayTitle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Fg.Primary}" />
                                                <TextBlock Text="{Binding DisplaySubtext}" FontSize="11"
                                                           Foreground="{DynamicResource Fg.Secondary}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 読み込み中オーバーレイ（非同期処理中, 仕様 §7 性能対策） -->
            <Border Background="{DynamicResource Bg.Overlay}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="6"
                                 Foreground="{DynamicResource Accent.Default}" Background="{DynamicResource Accent.Muted}" BorderThickness="0" />
                    <TextBlock Text="読み込み中…" Foreground="{DynamicResource Fg.Secondary}" Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ⑤ 下部詳細パネル（選択セルの値・数式差分, 仕様 §4） -->
        <Border x:Name="DetailPanel" Grid.Row="4" Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="14,8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="DetailHeader" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           FontWeight="Bold" Foreground="{DynamicResource Fg.Primary}" Margin="0,0,0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="変更前:" Foreground="{DynamicResource Diff.Del.Fg}"
                           FontWeight="Bold" Margin="0,0,10,0" />
                <TextBlock x:Name="DetailBeforeLine" Grid.Row="1" Grid.Column="1"
                           FontFamily="Consolas, Yu Gothic UI" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="変更後:" Foreground="{DynamicResource Diff.Add.Fg}"
                           FontWeight="Bold" Margin="0,2,10,0" />
                <TextBlock x:Name="DetailAfterLine" Grid.Row="2" Grid.Column="1"
                           FontFamily="Consolas, Yu Gothic UI" TextWrapping="Wrap" Margin="0,2,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
