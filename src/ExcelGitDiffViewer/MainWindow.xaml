<Window x:Class="ExcelGitDiffViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ExcelGitDiffViewer.Converters"
        Title="Excel Git Diff Viewer" Height="720" Width="1180"
        Icon="/Assets/app.ico"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:DiffKindToBrushConverter x:Key="DiffBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ① ツールバー -->
        <Border Grid.Row="0" Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="ファイルを開く…" Padding="10,3"
                        Click="OnOpenFilesClick" />
                <Button DockPanel.Dock="Right" Content="Git から開く…" Padding="10,3" Margin="0,0,6,0"
                        Click="OnOpenFromGitClick" />
                <TextBlock Text="Excel Git Diff Viewer" Foreground="{DynamicResource Fg.Primary}"
                           FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <!-- 表示モード切替（仕様 §4） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                    <Button Content="🏠 ホーム" Padding="10,3" Margin="0,0,12,0"
                            Click="OnShowHomeClick" />
                    <Button Content="データ・数式ビュー" Padding="10,3" Margin="0,0,6,0"
                            Click="OnShowDataView" />
                    <Button Content="VBAコードビュー" Padding="10,3"
                            IsEnabled="{Binding HasVba}" Click="OnShowVbaView" />
                </StackPanel>
                <!-- レビューモード操作（データ・数式ビュー／VBA コードビュー表示中） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                            Visibility="{Binding ShowReviewToolbar, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="レビューモード（差分のみ）" VerticalAlignment="Center"
                              IsChecked="{Binding IsReviewMode, Mode=TwoWay}" />
                    <TextBlock Text="{Binding SelectedSheet.DiffRowCount, StringFormat=差分 {0} 件}"
                               Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Visibility="{Binding IsDataView, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding SelectedVbaModule.DiffLineCount, StringFormat=差分 {0} 行}"
                               Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Visibility="{Binding IsVbaView, Converter={StaticResource BoolToVis}}" />
                    <Button Content="▲ 前" Padding="8,3" Margin="12,0,0,0"
                            Click="OnPrevDiffClick" ToolTip="前の差分へ" />
                    <Button Content="▼ 次" Padding="8,3" Margin="6,0,0,0"
                            Click="OnNextDiffClick" ToolTip="次の差分へ" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ② 対象ファイル情報バー（読み込み後のみ表示） -->
        <Border Grid.Row="1" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1" Padding="12,6"
                Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="変更前: " FontWeight="Bold" Foreground="{DynamicResource Diff.Del.Fg}" />
                    <TextBlock Text="{Binding LeftFilePath}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding LeftFilePath}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="  ⇄  " FontWeight="Bold" Foreground="{DynamicResource Fg.Secondary}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="変更後: " FontWeight="Bold" Foreground="{DynamicResource Diff.Add.Fg}" />
                    <TextBlock Text="{Binding RightFilePath}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding RightFilePath}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ③ コンテンツ領域 -->
        <Grid Grid.Row="2">
            <!-- シート選択タブ + 左右 DataGrid（データ・数式ビュー） -->
            <Grid Visibility="{Binding ShowDataArea, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- シートタブ（選択用） -->
                <ListBox Grid.Row="0" BorderThickness="0" Background="{DynamicResource Bg.SurfaceAlt}" Padding="4,4,4,0"
                         ItemsSource="{Binding Sheets}"
                         SelectedItem="{Binding SelectedSheet, Mode=TwoWay}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="2,0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="{DynamicResource Bg.Elevated}" BorderBrush="{DynamicResource Border.Default}"
                                                BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="12,6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent.Default}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Fg.OnAccent}" />
                                                <Setter Property="TextElement.FontWeight" Value="Bold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 左右 DataGrid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="LeftGrid" Grid.Column="0"
                              Style="{StaticResource DiffGridStyle}"
                              ItemsSource="{Binding SelectedSheet.DisplayLeftRows}"
                              ScrollViewer.ScrollChanged="OnGridScrollChanged"
                              SelectedCellsChanged="OnSelectedCellsChanged" />

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource Border.Strong}" />

                    <DataGrid x:Name="RightGrid" Grid.Column="2"
                              Style="{StaticResource DiffGridStyle}"
                              ItemsSource="{Binding SelectedSheet.DisplayRightRows}"
                              ScrollViewer.ScrollChanged="OnGridScrollChanged"
                              SelectedCellsChanged="OnSelectedCellsChanged" />
                </Grid>

            </Grid>

            <!-- VBA コードビュー -->
            <Grid Visibility="{Binding ShowVbaArea, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- モジュール一覧（レビュー ON 時は変更ありのみ） -->
                <ListBox Grid.Column="0" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,1,0"
                         ItemsSource="{Binding DisplayVbaModules}"
                         SelectedItem="{Binding SelectedVbaModule, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}" Padding="4,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 選択モジュールの行差分 -->
                <DockPanel Grid.Column="1">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Bg.Surface}" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="変更前" FontWeight="Bold" Foreground="{DynamicResource Diff.Del.Fg}" />
                            <TextBlock Grid.Column="1" Text="変更後" FontWeight="Bold" Foreground="{DynamicResource Diff.Add.Fg}" />
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="VbaLinesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="VbaLinesItems" ItemsSource="{Binding SelectedVbaModule.DisplayLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding LeftNumberDisplay}"
                                                   Foreground="{DynamicResource Grid.RowNumberFg}" TextAlignment="Right"
                                                   FontFamily="Consolas" Padding="0,0,6,0" />
                                        <Border Grid.Column="1"
                                                Background="{Binding LeftKind, Converter={StaticResource DiffBrush}}">
                                            <TextBlock Text="{Binding LeftText}" FontFamily="Consolas"
                                                       TextWrapping="NoWrap" />
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{Binding RightNumberDisplay}"
                                                   Foreground="{DynamicResource Grid.RowNumberFg}" TextAlignment="Right"
                                                   FontFamily="Consolas" Padding="0,0,6,0" />
                                        <Border Grid.Column="4"
                                                Background="{Binding RightKind, Converter={StaticResource DiffBrush}}">
                                            <TextBlock Text="{Binding RightText}" FontFamily="Consolas"
                                                       TextWrapping="NoWrap" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- エラー表示 -->
            <Border Background="{DynamicResource State.Error.Bg}" BorderBrush="{DynamicResource State.Error.Border}" BorderThickness="1" CornerRadius="6"
                    Padding="20" Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="560"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="解析できませんでした" FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource State.Error.Fg}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource State.Error.Fg}" />
                </StackPanel>
            </Border>

            <!-- ホーム画面（比較方法の選択）。起動直後・「ホーム」ボタンで表示 -->
            <Grid Visibility="{Binding ShowHome, Converter={StaticResource BoolToVis}}"
                  Background="{DynamicResource Bg.Window}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
                    <TextBlock Text="Excel Git Diff Viewer" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource Fg.Primary}" HorizontalAlignment="Center" />
                    <TextBlock Text="比較方法を選んでください" FontSize="14"
                               Foreground="{DynamicResource Fg.Secondary}"
                               HorizontalAlignment="Center" Margin="0,6,0,28" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Width="300" Height="180" Margin="0,0,20,0" Click="OnHomeCompareFilesClick">
                            <StackPanel>
                                <TextBlock Text="📂" FontSize="46" HorizontalAlignment="Center" />
                                <TextBlock Text="ファイルを比較" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,12,0,6" />
                                <TextBlock Text="2つの Excel ファイルを選んで比較します"
                                           FontSize="12" Foreground="{DynamicResource Fg.Secondary}"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="240" />
                            </StackPanel>
                        </Button>
                        <Button Width="300" Height="180" Click="OnHomeCompareGitClick">
                            <StackPanel>
                                <TextBlock Text="🔀" FontSize="46" HorizontalAlignment="Center" />
                                <TextBlock Text="Git 比較" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,12,0,6" />
                                <TextBlock Text="Git 管理下の Excel をコミット間で比較します"
                                           FontSize="12" Foreground="{DynamicResource Fg.Secondary}"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="240" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 読み込み中オーバーレイ（非同期処理中, 仕様 §7 性能対策） -->
            <Border Background="{DynamicResource Bg.Overlay}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="6"
                                 Foreground="{DynamicResource Accent.Default}" Background="{DynamicResource Accent.Muted}" BorderThickness="0" />
                    <TextBlock Text="読み込み中…" Foreground="{DynamicResource Fg.Secondary}" Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ④ 下部詳細パネル（選択セルの値・数式差分, 仕様 §4） -->
        <Border x:Name="DetailPanel" Grid.Row="3" Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="14,8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="DetailHeader" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           FontWeight="Bold" Foreground="{DynamicResource Fg.Primary}" Margin="0,0,0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="変更前:" Foreground="{DynamicResource Diff.Del.Fg}"
                           FontWeight="Bold" Margin="0,0,10,0" />
                <TextBlock x:Name="DetailBeforeLine" Grid.Row="1" Grid.Column="1"
                           FontFamily="Consolas, Yu Gothic UI" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="変更後:" Foreground="{DynamicResource Diff.Add.Fg}"
                           FontWeight="Bold" Margin="0,2,10,0" />
                <TextBlock x:Name="DetailAfterLine" Grid.Row="2" Grid.Column="1"
                           FontFamily="Consolas, Yu Gothic UI" TextWrapping="Wrap" Margin="0,2,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
