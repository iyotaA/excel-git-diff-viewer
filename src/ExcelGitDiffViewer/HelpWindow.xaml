<Window x:Class="ExcelGitDiffViewer.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作ガイド" Height="720" Width="640"
        Icon="/Assets/app.ico"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- TabControl / TabItem: ピル型（丸角）カスタムテンプレ。既定の OS スタイルを避けてテーマ色に統一。 -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,12"
                                      Panel.ZIndex="1" />
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Elevated}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent.Default}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent.Default}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KeyChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Elevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Yu Gothic UI" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
        </Style>
        <Style x:Key="OpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
        <Style x:Key="BodyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Excel Git Diff Viewer 操作ガイド" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource Fg.Primary}" />
            <TextBlock Text="キーボードショートカット・基本操作・アプリ情報のまとめです。"
                       Foreground="{DynamicResource Fg.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="キーボードショートカット">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyChip}" Margin="0,0,0,6">
                        <TextBlock Text="F3" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="次の差分へジャンプ" Style="{StaticResource OpText}" Margin="12,0,0,6" />

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyChip}" Margin="0,0,0,6">
                        <TextBlock Text="Shift + F3" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="前の差分へジャンプ" Style="{StaticResource OpText}" Margin="12,0,0,6" />

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyChip}" Margin="0,0,0,6">
                        <TextBlock Text="Ctrl + O" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="ファイルを開く（比較する2ファイルを選択）" Style="{StaticResource OpText}" Margin="12,0,0,6" />

                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyChip}" Margin="0,0,0,6">
                        <TextBlock Text="Ctrl + F" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="差分内検索バーの表示 / 非表示（データ・数式ビュー時のみ）" Style="{StaticResource OpText}" Margin="12,0,0,6" />

                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource KeyChip}" Margin="0,0,0,6">
                        <TextBlock Text="Ctrl + H / Ctrl + 1" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="ホーム画面へ" Style="{StaticResource OpText}" Margin="12,0,0,6" />

                    <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource KeyChip}" Margin="0,0,0,6">
                        <TextBlock Text="Ctrl + 2" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="データ・数式ビュー" Style="{StaticResource OpText}" Margin="12,0,0,6" />

                    <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource KeyChip}" Margin="0,0,0,6">
                        <TextBlock Text="Ctrl + 3" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="VBA コードビュー" Style="{StaticResource OpText}" Margin="12,0,0,6" />

                    <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource KeyChip}" Margin="0,0,0,6">
                        <TextBlock Text="Ctrl + R" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="レビューモード（差分のみ表示）を切替" Style="{StaticResource OpText}" Margin="12,0,0,6" />

                    <Border Grid.Row="8" Grid.Column="0" Style="{StaticResource KeyChip}" Margin="0,0,0,6">
                        <TextBlock Text="Alt + ← / →" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="前 / 次のシート（VBA ビュー時はモジュール）に切替" Style="{StaticResource OpText}" Margin="12,0,0,6" />

                    <Border Grid.Row="9" Grid.Column="0" Style="{StaticResource KeyChip}" Margin="0,0,0,6">
                        <TextBlock Text="F1" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="操作ガイドを開く（このウィンドウ）" Style="{StaticResource OpText}" Margin="12,0,0,6" />

                    <Border Grid.Row="10" Grid.Column="0" Style="{StaticResource KeyChip}" Margin="0,0,0,6">
                        <TextBlock Text="Enter / Shift+Enter" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="検索バー内で次 / 前のヒットへ" Style="{StaticResource OpText}" Margin="12,0,0,6" />

                    <Border Grid.Row="11" Grid.Column="0" Style="{StaticResource KeyChip}" Margin="0,0,0,6">
                        <TextBlock Text="Esc" Style="{StaticResource KeyText}" />
                    </Border>
                    <TextBlock Grid.Row="11" Grid.Column="1" Text="検索バーを閉じる" Style="{StaticResource OpText}" Margin="12,0,0,6" />
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="基本操作">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                <StackPanel>
                <TextBlock Text="1. ファイル比較の始め方" Style="{StaticResource BodyLabel}" />
                <TextBlock Style="{StaticResource Body}">
                    ホーム画面の「📂 ファイルを比較」を押し、変更前・変更後の 2 つの Excel ファイル（.xlsx / .xlsm / .xls）を順に選ぶと差分計算が始まります。ショートカット Ctrl + O でも同じフローに入れます。
                </TextBlock>

                <TextBlock Text="2. Git 比較の始め方" Style="{StaticResource BodyLabel}" />
                <TextBlock Style="{StaticResource Body}">
                    ホーム画面の「🔀 Git 比較」から、Git 管理下の Excel ファイルを選択します。コミット選択ダイアログで左（変更前）・右（変更後）の 2 つのリビジョンを選ぶと、その時点のファイルを一時的に取り出して比較します。
                </TextBlock>

                <TextBlock Text="3. レビューモードと差分種別フィルタ" Style="{StaticResource BodyLabel}" />
                <TextBlock Style="{StaticResource Body}">
                    「レビューモード（差分のみ）」を ON にすると差分がある行だけが表示されます。隣の「追加 / 変更 / 削除」チェックで内訳を絞り込めます。いずれかを OFF にした瞬間、自動でレビューモードが ON になります。
                </TextBlock>

                <TextBlock Text="4. 差分内検索" Style="{StaticResource BodyLabel}" />
                <TextBlock Style="{StaticResource Body}">
                    Ctrl + F で検索バーを開き、セルの値または数式に含まれる文字列でヒットを一覧できます。Enter で次、Shift + Enter で前へ。「全シート」チェックで横断検索します。
                </TextBlock>

                <TextBlock Text="5. サマリーバー" Style="{StaticResource BodyLabel}" />
                <TextBlock Style="{StaticResource Body}">
                    ファイル情報バーの下に、変更シート数・追加行数・削除行数・変更セル数・VBA 変更モジュール数がバッジ表示されます。全体像を把握してから明細に入るのに使います。
                </TextBlock>

                <TextBlock Text="6. テーマ切替" Style="{StaticResource BodyLabel}" />
                <TextBlock Style="{StaticResource Body}">
                    ツールバー左上の「🌙 / ☀」ボタンでダーク / ライトを切り替えます。選択は次回起動時にも引き継がれます。
                </TextBlock>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="このアプリについて">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                <StackPanel>
                    <TextBlock Text="Excel Git Diff Viewer" FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource Fg.Primary}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="バージョン: " Foreground="{DynamicResource Fg.Secondary}" />
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource Fg.Primary}" />
                    </StackPanel>
                    <TextBlock Text="© 2026 Akihiro Iyota." Foreground="{DynamicResource Fg.Secondary}" Margin="0,0,0,4" />
                    <TextBlock Text="Excel ブック（.xlsx / .xlsm / .xls）と VBA プロジェクトの差分を GUI で比較するツールです。Git の difftool として登録して使うこともできます。"
                               Foreground="{DynamicResource Fg.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="閉じる" Width="96" Height="30" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
