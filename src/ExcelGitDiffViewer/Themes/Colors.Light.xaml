<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ライトテーマの色トークン（B-4）。Colors.Dark.xaml と同じキー名で明背景版の配色を定義する。
        ThemeManager が MergedDictionaries[0] を Dark/Light のこの辞書と差し替えることで全体が切り替わる。
        パレットは docs/機能追加提案書.html の Excel ブランドグリーン系を踏襲。
    -->

    <!-- 背景階層 -->
    <SolidColorBrush x:Key="Bg.Window"     Color="#FFF6F9F7" />
    <SolidColorBrush x:Key="Bg.Surface"    Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Bg.SurfaceAlt" Color="#FFF0F4F1" />
    <SolidColorBrush x:Key="Bg.Elevated"   Color="#FFEDF2EE" />
    <SolidColorBrush x:Key="Bg.Overlay"    Color="#CCFFFFFF" />

    <!-- 前景 -->
    <SolidColorBrush x:Key="Fg.Primary"    Color="#FF17231D" />
    <SolidColorBrush x:Key="Fg.Secondary"  Color="#FF5C6E64" />
    <SolidColorBrush x:Key="Fg.Muted"      Color="#FF84978B" />
    <SolidColorBrush x:Key="Fg.OnAccent"   Color="#FFFFFFFF" />

    <!-- 境界 -->
    <SolidColorBrush x:Key="Border.Default" Color="#FFE4EAE5" />
    <SolidColorBrush x:Key="Border.Strong"  Color="#FFCCD8CF" />
    <SolidColorBrush x:Key="Border.Focus"   Color="#FF217346" />

    <!-- アクセント（Excel 緑） -->
    <SolidColorBrush x:Key="Accent.Default" Color="#FF217346" />
    <SolidColorBrush x:Key="Accent.Hover"   Color="#FF2A8B57" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#FF0E4A2B" />
    <SolidColorBrush x:Key="Accent.Muted"   Color="#FFE9F2EC" />

    <!-- 差分セル（背景 bg / 文字 fg） -->
    <SolidColorBrush x:Key="Diff.Add.Bg" Color="#FFE6F3EA" />
    <SolidColorBrush x:Key="Diff.Add.Fg" Color="#FF1B6035" />
    <SolidColorBrush x:Key="Diff.Del.Bg" Color="#FFFBEAEB" />
    <SolidColorBrush x:Key="Diff.Del.Fg" Color="#FF9A2C28" />
    <SolidColorBrush x:Key="Diff.Chg.Bg" Color="#FFFCF4D8" />
    <SolidColorBrush x:Key="Diff.Chg.Fg" Color="#FF876811" />
    <SolidColorBrush x:Key="Diff.Gap.Bg" Color="#FFF6F6F6" />

    <!-- インライン差分（詳細パネルの文字単位ハイライト） -->
    <SolidColorBrush x:Key="Inline.Del.Bg" Color="#FFFCD8DA" />
    <SolidColorBrush x:Key="Inline.Del.Fg" Color="#FF9A2C28" />
    <SolidColorBrush x:Key="Inline.Ins.Bg" Color="#FFCBEBD5" />
    <SolidColorBrush x:Key="Inline.Ins.Fg" Color="#FF1B6035" />

    <!-- グリッド -->
    <SolidColorBrush x:Key="Grid.Line"           Color="#FFE4EAE5" />
    <SolidColorBrush x:Key="Grid.HeaderBg"       Color="#FFEDF2EE" />
    <SolidColorBrush x:Key="Grid.HeaderFg"       Color="#FF3D4F44" />
    <SolidColorBrush x:Key="Grid.RowNumberBg"    Color="#FFF2F5F3" />
    <SolidColorBrush x:Key="Grid.RowNumberFg"    Color="#FF84978B" />
    <SolidColorBrush x:Key="Grid.CellSelectedBg" Color="#FFB8D9C6" />

    <!-- 状態 -->
    <SolidColorBrush x:Key="State.Error.Bg"     Color="#FFFBEAEB" />
    <SolidColorBrush x:Key="State.Error.Fg"     Color="#FF9A2C28" />
    <SolidColorBrush x:Key="State.Error.Border" Color="#FFD26B67" />

    <!-- その他 -->
    <SolidColorBrush x:Key="Marker.Formula.Fg"   Color="#FF1B6035" />
    <SolidColorBrush x:Key="ScrollBar.Thumb"      Color="#FFB8C3BC" />
    <SolidColorBrush x:Key="ScrollBar.ThumbHover" Color="#FF98A99F" />
</ResourceDictionary>
