<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ダークテーマの色トークン（用途ベースのセマンティック命名）。
        全ての色はここに集約し、XAML/コードからは DynamicResource / キー引きで参照する。
        将来ライトテーマを足す場合は、同じキーで別辞書（Colors.Light.xaml）を用意し差し替える。
    -->

    <!-- 背景階層 -->
    <SolidColorBrush x:Key="Bg.Window"     Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="Bg.Surface"    Color="#FF252526" />
    <SolidColorBrush x:Key="Bg.SurfaceAlt" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="Bg.Elevated"   Color="#FF333337" />
    <SolidColorBrush x:Key="Bg.Overlay"    Color="#CC1E1E1E" />

    <!-- 前景 -->
    <SolidColorBrush x:Key="Fg.Primary"    Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="Fg.Secondary"  Color="#FFB4B4B4" />
    <SolidColorBrush x:Key="Fg.Muted"      Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="Fg.OnAccent"   Color="#FFFFFFFF" />

    <!-- 境界 -->
    <SolidColorBrush x:Key="Border.Default" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="Border.Strong"  Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="Border.Focus"   Color="#FF4CC2FF" />

    <!-- アクセント（緑） -->
    <SolidColorBrush x:Key="Accent.Default" Color="#FF2EA043" />
    <SolidColorBrush x:Key="Accent.Hover"   Color="#FF3FB950" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#FF238636" />
    <SolidColorBrush x:Key="Accent.Muted"   Color="#FF1F6F32" />

    <!-- 差分セル（背景 bg / 文字 fg） -->
    <SolidColorBrush x:Key="Diff.Add.Bg" Color="#FF12331F" />
    <SolidColorBrush x:Key="Diff.Add.Fg" Color="#FF4AC77E" />
    <SolidColorBrush x:Key="Diff.Del.Bg" Color="#FF3A1D1F" />
    <SolidColorBrush x:Key="Diff.Del.Fg" Color="#FFF0776C" />
    <SolidColorBrush x:Key="Diff.Chg.Bg" Color="#FF3A331A" />
    <SolidColorBrush x:Key="Diff.Chg.Fg" Color="#FFE2C08D" />
    <SolidColorBrush x:Key="Diff.Gap.Bg" Color="#FF232323" />

    <!-- インライン差分（詳細パネルの文字単位ハイライト） -->
    <SolidColorBrush x:Key="Inline.Del.Bg" Color="#FF5A1E22" />
    <SolidColorBrush x:Key="Inline.Del.Fg" Color="#FFFFDCE0" />
    <SolidColorBrush x:Key="Inline.Ins.Bg" Color="#FF1B4426" />
    <SolidColorBrush x:Key="Inline.Ins.Fg" Color="#FFDBFFE4" />

    <!-- グリッド -->
    <SolidColorBrush x:Key="Grid.Line"           Color="#FF333333" />
    <SolidColorBrush x:Key="Grid.HeaderBg"       Color="#FF2D2D30" />
    <SolidColorBrush x:Key="Grid.HeaderFg"       Color="#FFC8C8C8" />
    <SolidColorBrush x:Key="Grid.RowNumberBg"    Color="#FF2A2A2C" />
    <SolidColorBrush x:Key="Grid.RowNumberFg"    Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="Grid.CellSelectedBg" Color="#FF264F78" />

    <!-- 状態 -->
    <SolidColorBrush x:Key="State.Error.Bg"     Color="#FF3A1D1F" />
    <SolidColorBrush x:Key="State.Error.Fg"     Color="#FFF0776C" />
    <SolidColorBrush x:Key="State.Error.Border" Color="#FFC74E48" />

    <!-- その他 -->
    <SolidColorBrush x:Key="Marker.Formula.Fg"   Color="#FF4AC77E" />
    <SolidColorBrush x:Key="ScrollBar.Thumb"      Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="ScrollBar.ThumbHover" Color="#FF5A5A5A" />
</ResourceDictionary>
